# Server Config
PORT=5000
NODE_ENV=development

# Database Connections
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caratline?schema=public"

# Authentication Secrets
JWT_SECRET="generate_a_strong_secret_key_here"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="generate_a_strong_refresh_secret_key_here"
JWT_REFRESH_EXPIRATION="7d"

# Payment Gateways (Stripe / Razorpay)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AI Integrations (OpenAI / Gemini / Custom Endpoint)
GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY="sk-proj-..."
AI_SERVICE_ENDPOINT="http://localhost:8000"

# Mail Config
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="noreply@caratline.com"
